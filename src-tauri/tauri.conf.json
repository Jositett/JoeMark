{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "JoeMark",
  "version": "1.2.4",
  "identifier": "com.joedroid.joemark",
  "build": {
    "beforeDevCommand": "node scripts/dev-server.mjs",
    "beforeBuildCommand": "npm run build:renderer && npm run build-frontend",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "JoeMark",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "center": true,
        "decorations": false,
        "devtools": false,
        "visible": false,
        "backgroundColor": "#f5f5f5"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; img-src 'self' data: blob: http: https:; font-src 'self' data: blob:; media-src 'self' blob: https: data:; frame-src 'self'; connect-src 'self' ipc: tauri: blob: http: https:; worker-src 'self' blob:;"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://raw.githubusercontent.com/Jositett/JoeMark/master/update-windows-x86_64.json",
        "https://github.com/Jositett/JoeMark/releases/latest/download/update-windows-x86_64.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlGMUE4QjA2QjFFN0Q1MzQKUldRMDFlZXhCb3Nhbnk3RGtqR3J0TERlMkNoNG9VOVRGZ3B6eHJ6T3RVbTNvSWNTcy9DNHYyeFoK"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../demo.md": "demo.md",
      "../assets/icon.png": "assets/icon.png"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "languages": [
          "English",
          "SimpChinese",
          "Spanish"
        ],
        "displayLanguageSelector": true,
        "installMode": "currentUser"
      }
    },
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown"
        ],
        "name": "Markdown",
        "description": "Markdown Document",
        "mimeType": "text/markdown"
      }
    ]
  }
}
